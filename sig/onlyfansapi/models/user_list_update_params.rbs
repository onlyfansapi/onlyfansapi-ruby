      attr_accessor account: String

      attr_accessor user_list_id: String

      attr_accessor name: String

      attr_accessor is_pinned_to_feed: bool?

      def initialize: (
        account: String,
        user_list_id: String,
        name: String,
        ?is_pinned_to_feed: bool?,
        ?request_options: Onlyfansapi::request_opts
      ) -> void

      def to_hash: -> {
