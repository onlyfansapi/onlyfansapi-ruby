    type user_list_update_params =
      {
        account: String,
        user_list_id: String,
        name: String,
        is_pinned_to_feed: bool?
      }
      & Onlyfansapi::Internal::Type::request_parameters

    class UserListUpdateParams < Onlyfansapi::Internal::Type::BaseModel
      extend Onlyfansapi::Internal::Type::RequestParameters::Converter
