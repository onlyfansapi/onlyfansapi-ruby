module Onlyfansapi
  module Models
    type post_stats_params =
      { account: String, post_id: Integer, with_historical_data: bool }
      & Onlyfansapi::Internal::Type::request_parameters

    class PostStatsParams < Onlyfansapi::Internal::Type::BaseModel
      extend Onlyfansapi::Internal::Type::RequestParameters::Converter
      include Onlyfansapi::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor post_id: Integer

      attr_reader with_historical_data: bool?

      def with_historical_data=: (bool) -> bool

      def initialize: (
        account: String,
        post_id: Integer,
        ?with_historical_data: bool,
        ?request_options: Onlyfansapi::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        post_id: Integer,
        with_historical_data: bool,
        request_options: Onlyfansapi::RequestOptions
      }
    end
  end
end
