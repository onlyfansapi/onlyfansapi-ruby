module Onlyfansapi
  module Resources
    class Media
      attr_reader vault: Onlyfansapi::Resources::Media::Vault

      def scrape: (
        String account,
        url: String,
        ?expiration_date: String?,
        ?request_options: Onlyfansapi::request_opts
      ) -> Onlyfansapi::Models::MediaScrapeResponse

      def upload: (
        String account,
        file: String,
        ?type: Onlyfansapi::Models::MediaUploadParams::type_,
        ?request_options: Onlyfansapi::request_opts
      ) -> Onlyfansapi::Models::MediaUploadResponse

      def initialize: (client: Onlyfansapi::Client) -> void
    end
  end
end
