module Onlyfansapi
  module Resources
    class Engagement
      class Messages
        class DirectMessages
          def list: (
            String account,
            ?end_date: String,
            ?limit: Integer,
            ?offset: Integer,
            ?query: String,
            ?start_date: String,
            ?request_options: Onlyfansapi::request_opts
          ) -> Onlyfansapi::Models::Engagement::Messages::DirectMessageListResponse

          def chart: (
