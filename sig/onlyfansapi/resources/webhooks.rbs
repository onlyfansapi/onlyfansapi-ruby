module Onlyfansapi
  module Resources
    class Webhooks
      def create: (
        account_scope: String,
        endpoint_url: String,
        events: ::Array[String],
        ?account_ids: ::Array[String],
        ?signing_secret: String?,
        ?request_options: Onlyfansapi::request_opts
      ) -> Onlyfansapi::Models::WebhookCreateResponse

      def delete: (
        String webhook_id,
        ?request_options: Onlyfansapi::request_opts
      ) -> top?

      def initialize: (client: Onlyfansapi::Client) -> void
    end
  end
end
