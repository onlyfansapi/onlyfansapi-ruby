        ?request_options: Onlyfansapi::request_opts
      ) -> Onlyfansapi::Models::TrackingLinkCreateResponse

      def list: (
        String account,
        ?end_date: String?,
        ?limit: Integer?,
        ?offset: Integer?,
        ?sort: Onlyfansapi::Models::TrackingLinkListParams::sort?,
        ?sortby: Onlyfansapi::Models::TrackingLinkListParams::sortby?,
        ?start_date: String?,
