module Onlyfans
  module Models
    type payout_request_manual_withdrawal_params =
      { account: String, amount: Integer }
      & Onlyfans::Internal::Type::request_parameters

    class PayoutRequestManualWithdrawalParams < Onlyfans::Internal::Type::BaseModel
      extend Onlyfans::Internal::Type::RequestParameters::Converter
      include Onlyfans::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor amount: Integer

      def initialize: (
        account: String,
        amount: Integer,
        ?request_options: Onlyfans::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        amount: Integer,
        request_options: Onlyfans::RequestOptions
      }
    end
  end
end
