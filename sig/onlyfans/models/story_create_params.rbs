module Onlyfans
  module Models
    type story_create_params =
      { account: String, media_files: ::Array[String] }
      & Onlyfans::Internal::Type::request_parameters

    class StoryCreateParams < Onlyfans::Internal::Type::BaseModel
      extend Onlyfans::Internal::Type::RequestParameters::Converter
      include Onlyfans::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor media_files: ::Array[String]

      def initialize: (
        account: String,
        media_files: ::Array[String],
        ?request_options: Onlyfans::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        media_files: ::Array[String],
        request_options: Onlyfans::RequestOptions
      }
    end
  end
end
