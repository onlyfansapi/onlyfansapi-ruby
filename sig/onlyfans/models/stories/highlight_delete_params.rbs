module Onlyfans
  module Models
    module Stories
      type highlight_delete_params =
        { account: String, highlight_id: Integer }
        & Onlyfans::Internal::Type::request_parameters

      class HighlightDeleteParams < Onlyfans::Internal::Type::BaseModel
        extend Onlyfans::Internal::Type::RequestParameters::Converter
        include Onlyfans::Internal::Type::RequestParameters

        attr_accessor account: String

        attr_accessor highlight_id: Integer

        def initialize: (
          account: String,
          highlight_id: Integer,
          ?request_options: Onlyfans::request_opts
        ) -> void

        def to_hash: -> {
          account: String,
          highlight_id: Integer,
          request_options: Onlyfans::RequestOptions
        }
      end
    end
  end
end
