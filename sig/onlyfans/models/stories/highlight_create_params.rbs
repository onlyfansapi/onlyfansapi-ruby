module Onlyfans
  module Models
    module Stories
      type highlight_create_params =
        {
          account: String,
          cover_story_id: Integer,
          story_ids: ::Array[String],
          title: String
        }
        & Onlyfans::Internal::Type::request_parameters

      class HighlightCreateParams < Onlyfans::Internal::Type::BaseModel
        extend Onlyfans::Internal::Type::RequestParameters::Converter
        include Onlyfans::Internal::Type::RequestParameters

        attr_accessor account: String

        attr_accessor cover_story_id: Integer

        attr_accessor story_ids: ::Array[String]

        attr_accessor title: String

        def initialize: (
          account: String,
          cover_story_id: Integer,
          story_ids: ::Array[String],
          title: String,
          ?request_options: Onlyfans::request_opts
        ) -> void

        def to_hash: -> {
          account: String,
          cover_story_id: Integer,
          story_ids: ::Array[String],
          title: String,
          request_options: Onlyfans::RequestOptions
        }
      end
    end
  end
end
