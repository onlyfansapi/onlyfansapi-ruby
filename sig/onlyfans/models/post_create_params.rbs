        voting_due: Integer,
        voting_options: ::Array[String],
        voting_type: Onlyfans::Models::PostCreateParams::voting_type,
        request_options: Onlyfans::RequestOptions
      }

      type voting_type = :poll | :quiz

      module VotingType
        extend Onlyfans::Internal::Type::Enum

        POLL: :poll
        QUIZ: :quiz

        def self?.values: -> ::Array[Onlyfans::Models::PostCreateParams::voting_type]
      end
