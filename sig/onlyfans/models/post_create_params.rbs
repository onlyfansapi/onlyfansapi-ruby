      attr_reader voting_options: ::Array[String]?

      def voting_options=: (::Array[String]) -> ::Array[String]

      attr_reader voting_type: Onlyfans::Models::PostCreateParams::voting_type?

      def voting_type=: (
        Onlyfans::Models::PostCreateParams::voting_type
      ) -> Onlyfans::Models::PostCreateParams::voting_type

      def initialize: (
        account: String,
        text: String,
        ?expire_days: Integer,
        ?fund_raising_target_amount: Integer,
        ?fund_raising_tips_presets: ::Array[String],
        ?label_ids: String,
        ?media_files: ::Array[top],
        ?previews: ::Array[top],
        ?rf_tag: String,
        ?save_for_later: bool,
        ?scheduled_date: String,
        ?voting_correct_index: Integer,
        ?voting_due: Integer,
        ?voting_options: ::Array[String],
        ?voting_type: Onlyfans::Models::PostCreateParams::voting_type,
        ?request_options: Onlyfans::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        text: String,
        expire_days: Integer,
        fund_raising_target_amount: Integer,
        fund_raising_tips_presets: ::Array[String],
        label_ids: String,
        media_files: ::Array[top],
        previews: ::Array[top],
        rf_tag: String,
        save_for_later: bool,
        scheduled_date: String,
