        voting_options: ::Array[String],
        voting_type: Onlyfans::Models::PostCreateParams::voting_type
      }
      & Onlyfans::Internal::Type::request_parameters

    class PostCreateParams < Onlyfans::Internal::Type::BaseModel
      extend Onlyfans::Internal::Type::RequestParameters::Converter
      include Onlyfans::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor text: String

      attr_reader expire_days: Integer?

      def expire_days=: (Integer) -> Integer

      attr_reader fund_raising_target_amount: Integer?

      def fund_raising_target_amount=: (Integer) -> Integer

      attr_reader fund_raising_tips_presets: ::Array[String]?

      def fund_raising_tips_presets=: (::Array[String]) -> ::Array[String]

      attr_reader label_ids: String?

      def label_ids=: (String) -> String

      attr_reader media_files: ::Array[top]?

      def media_files=: (::Array[top]) -> ::Array[top]

      attr_reader previews: ::Array[top]?

      def previews=: (::Array[top]) -> ::Array[top]

      attr_reader rf_tag: String?

      def rf_tag=: (String) -> String

      attr_reader save_for_later: bool?

      def save_for_later=: (bool) -> bool

      attr_reader scheduled_date: String?

      def scheduled_date=: (String) -> String

      attr_reader voting_correct_index: Integer?

