module Onlyfans
  module Models
    module Settings
      type social_media_button_delete_params =
        { account: String, button_id: String }
        & Onlyfans::Internal::Type::request_parameters

      class SocialMediaButtonDeleteParams < Onlyfans::Internal::Type::BaseModel
        extend Onlyfans::Internal::Type::RequestParameters::Converter
        include Onlyfans::Internal::Type::RequestParameters

        attr_accessor account: String

        attr_accessor button_id: String

        def initialize: (
          account: String,
          button_id: String,
          ?request_options: Onlyfans::request_opts
        ) -> void

        def to_hash: -> {
          account: String,
          button_id: String,
          request_options: Onlyfans::RequestOptions
        }
      end
    end
  end
end
