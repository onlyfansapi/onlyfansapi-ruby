module Onlyfans
  module Models
    type media_download_params =
      { account: String, cdn_url: String }
      & Onlyfans::Internal::Type::request_parameters

    class MediaDownloadParams < Onlyfans::Internal::Type::BaseModel
      extend Onlyfans::Internal::Type::RequestParameters::Converter
      include Onlyfans::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor cdn_url: String

      def initialize: (
        account: String,
        cdn_url: String,
        ?request_options: Onlyfans::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        cdn_url: String,
        request_options: Onlyfans::RequestOptions
      }
    end
  end
end
