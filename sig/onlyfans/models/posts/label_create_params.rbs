module Onlyfans
  module Models
    module Posts
      type label_create_params =
        { account: String, name: String }
        & Onlyfans::Internal::Type::request_parameters

      class LabelCreateParams < Onlyfans::Internal::Type::BaseModel
        extend Onlyfans::Internal::Type::RequestParameters::Converter
        include Onlyfans::Internal::Type::RequestParameters

        attr_accessor account: String

        attr_accessor name: String

        def initialize: (
          account: String,
          name: String,
          ?request_options: Onlyfans::request_opts
        ) -> void

        def to_hash: -> {
          account: String,
          name: String,
          request_options: Onlyfans::RequestOptions
        }
      end
    end
  end
end
