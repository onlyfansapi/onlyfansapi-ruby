module Onlyfans
  module Models
    type promotion_delete_params =
      { account: String, promotion_id: String }
      & Onlyfans::Internal::Type::request_parameters

    class PromotionDeleteParams < Onlyfans::Internal::Type::BaseModel
      extend Onlyfans::Internal::Type::RequestParameters::Converter
      include Onlyfans::Internal::Type::RequestParameters

      attr_accessor account: String

      attr_accessor promotion_id: String

      def initialize: (
        account: String,
        promotion_id: String,
        ?request_options: Onlyfans::request_opts
      ) -> void

      def to_hash: -> {
        account: String,
        promotion_id: String,
        request_options: Onlyfans::RequestOptions
      }
    end
  end
end
